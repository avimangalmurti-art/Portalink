# Template only: do not overwrite an existing .env.local.
# Use "prototype" with placeholder Supabase values for isolated design review.
# Prototype mode alone does not disable valid Supabase connections.
# Hosted environments use "production" so missing durable services fail closed.
VITE_RUNTIME_MODE=prototype

# Safe to expose in the browser. Database and storage access are enforced by RLS.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Legacy variable: account deletion is hard-disabled in source and the endpoint.
# Keep false; changing it does not enable deletion. See docs/account-deletion-safety.md.
VITE_ENABLE_ACCOUNT_DELETION=false

# Sites worker runtime variable (not VITE_ and not bundled into the browser).
# Set to the confirmed platform owner's profiles.id before enabling load-timing Insights.
# Empty/missing fails closed. Configure through Sites only with approval.
RUM_OWNER_PROFILE_ID=
