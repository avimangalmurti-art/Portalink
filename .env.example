# Use "prototype" only for local design review. Hosted environments must use
# "production" so missing durable services fail closed instead of showing fixtures.
VITE_RUNTIME_MODE=prototype

# Safe to expose in the browser. Database and storage access are enforced by RLS.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Turn this on only after deploying supabase/functions/delete-account.
VITE_ENABLE_ACCOUNT_DELETION=false
